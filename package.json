{
  "name": "@cedw032/cidr-types",
  "version": "0.1.0",
  "description": "IPv4 and CIDR literal types, range proofs and runtime validation",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "license": "MIT",
  "author": "Chad Edwards",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cedw032/cidr-types.git"
  },
  "homepage": "https://github.com/cedw032/cidr-types#readme",
  "bugs": {
    "url": "https://github.com/cedw032/cidr-types/issues"
  },
  "keywords": [
    "cidr",
    "ipv4",
    "typescript",
    "type-level",
    "subnet",
    "validation"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test:types": "tsc -p tsconfig.test.json",
    "test": "npm run build && npm run test:types && node --test test/runtime.test.mjs && python3 test/oracle.py && node scripts/smoke.mjs",
    "prepublishOnly": "npm test"
  },
  "devDependencies": {
    "typescript": "6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  }
}
